# The image tag (install.md §1), e.g. 0.1.0-dev.1 — never "latest": an upgrade is a deliberate change of this line.
# COMFYFARM_IMAGE (default ghcr.io/frozenrainy/comfyfarm) only for an image you built or mirror yourself.
COMFYFARM_VERSION=
# The secrets are files (db_password, gateway_secret, session_key), made once with `comfyfarm secrets --write`
COMFYFARM_SECRETS_DIR=/srv/comfyfarm/secrets
# The UI worker: a stock ComfyUI (CPU is enough) with the comfyfarm_ui extension, reachable from this host
# auto = the UI worker set up in the dashboard (System → Workers → Set up a worker → UI worker); or a fixed URL
UI_WORKER_URL=auto
# Optional
COMFYFARM_INSTANCE=comfyfarm-1
COMFYFARM_DEFAULT_GROUP=
# Ports: prefer <host-ip>:<port> (e.g. ROUTER_PORT=192.0.2.10:8188) — a bare port is published on every address
ROUTER_PORT=8188
GATEWAY_PORT=8080
# POSTGRES_VERSION=17
# state the router keeps lives outside the release directory, so an upgrade cannot remove it
COMFYFARM_KEYS_DIR=/srv/comfyfarm/keys
COMFYFARM_BACKUP_DIR=/srv/comfyfarm/backups
# the UI worker's user directory as seen on this host (users' workflows and settings), so backups include it
# COMFYFARM_USER_DIR=/mnt/farm/user
# COMFYFARM_ARTIFACTS_MOUNT=/srv/comfyfarm/art
# The builder and the UI worker container (docs/design/15) — uncomment the block: the builder builds what the dashboard
# asks for into the store (it needs internet, or a mirror), the UI worker runs on this host. The store and the shared
# storage at the SAME absolute path the GPU workers mount them at.
# COMPOSE_PROFILES=farm
# COMFYFARM_ARTIFACTS_MOUNT=/srv/comfyfarm/art
# COMFYFARM_SHARED=/srv/comfyfarm/shared
# models from the dashboard (System → Models, docs/guide/models.md): the store the builder downloads into
# COMFYFARM_MODELS_MOUNT=/srv/comfyfarm/model-store
# node packs uploaded as archives (docs/design/18) — they do not come from the allowed sources above
# COMFYFARM_BUILD_NODE_ARCHIVES=1
# COMFYFARM_BUILDS_DIR=/builds
# COMFYFARM_UI_SERVICE=http://ui:8189
# COMFYFARM_UI_AGENT=http://ui:8399
# Node packs picked in the dashboard: off unless you name where they may come from
# COMFYFARM_BUILD_NODE_SOURCES=https://github.com/
