# Copy to .env, then append the two secrets (COMFYFARM_GATEWAY_SECRET, COMFYFARM_SESSION_KEY) with:
#   docker run --rm comfyfarm:latest comfyfarm secrets >> .env
DB_PASSWORD=
# The UI worker: a stock ComfyUI (CPU is enough) with the comfyfarm_ui extension, reachable from this host
# auto = the UI worker set up in the dashboard (System → Workers → Set up a worker → UI worker); or a fixed URL
UI_WORKER_URL=auto
# Optional
COMFYFARM_INSTANCE=comfyfarm-1
COMFYFARM_DEFAULT_GROUP=
ROUTER_PORT=8188
GATEWAY_PORT=8080
# state the router keeps lives outside the release directory, so an upgrade cannot remove it
COMFYFARM_KEYS_DIR=/srv/comfyfarm/keys
COMFYFARM_BACKUP_DIR=/srv/comfyfarm/backups
# the UI worker's user directory as seen on this host (users' workflows and settings), so backups include it
# COMFYFARM_USER_DIR=/mnt/farm/user
# COMFYFARM_ARTIFACTS_MOUNT=/srv/comfyfarm/art
