# ~/.config/comfyfarm/<instance>.env on a worker host (read by comfyfarm@<instance>.service)
COMFY_LAUNCH_ROUTER=http://router-host:8188
COMFY_LAUNCH_INSTANCE=gpu-1
COMFY_LAUNCH_ARTIFACTS=/srv/comfyfarm/art
COMFY_LAUNCH_LOCAL=/srv/comfyfarm/local
COMFY_LAUNCH_PREFIXES=/srv/comfyfarm/models,/mnt/farm
